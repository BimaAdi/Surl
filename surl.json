{
  "global": {
    "variable": {
      "url": "http://127.0.0.1:8080"
    },
    "headers": {
      "Authorization": "Bearer sometoken"
    },
    "basic-auth": {
      "username": "myusername",
      "password": "some-password"
    },
    "tls-config": {
      "insecure-skip-verify": true
    }
  },
  "api": {
    "get_post_id": {
      "url": "{url}/posts/25",
      "method": "GET"
    },
    "create_post_json": {
      "url": "{url}/posts",
      "method": "POST",
      "json": {
        "title": "some title",
        "body": "some body"
      }    
    },
    "create_post_form": {
      "url": "{url}/posts",
      "method": "POST",
      "form": [
        {
          "name": "title",
          "value": "some title"
        },
        {
          "name": "body",
          "value": "some body"
        }
      ]
    },
    "create_post_multipart": {
      "url": "{url}/posts",
      "method": "POST",
      "form_multipart": [
        {
            "name": "username",
            "type": "string",
            "value": "hello"
        },
        {
            "name": "file",
            "type": "file",
            "file_name": "README.md",
            "file_path": "./README.md"
        }
      ]
    },
    "create_post_raw": {
      "url": "{url}/posts",
      "method": "POST",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"title\":\"some title\", \"body\":\"some body\"}"
    },
    "get_comments": {
      "url": "{url}/comments",
      "method": "GET",
      "query": {
        "postId": "100" 
      }
    },
    "mirror": {
      "url": "{url}/mirror",
      "method": "POST",
      "query": {
        "status": "400"
      },
      "json": {
        "title": "some title",
        "body": "some body"
      }
    },
    "get_post_basic_auth": {
      "url": "{url}/posts/25",
      "method": "GET",
      "tls-config": {
        "insecure-skip-verify": true
      },
      "basic-auth": {
        "username": "myusername",
        "password": "some-password"
      }
    }
  }
}
