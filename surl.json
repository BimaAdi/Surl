{
  "global": {
    "variable": {
      "url": "https://jsonplaceholder.typicode.com"
    }
  },
  "api": {
    "get_post_id": {
      "url": "{url}/posts/25",
      "method": "GET"
    },
    "create_post_json": {
      "url": "{url}/posts",
      "method": "POST",
      "json": {
        "title": "some title",
        "body": "some body"
      }    
    },
    "create_post_form": {
      "url": "{url}/posts",
      "method": "POST",
      "form": [
        {
          "name": "title",
          "value": "some title"
        },
        {
          "name": "body",
          "value": "some body"
        }
      ]
    },
    "create_post_raw": {
      "url": "{url}/posts",
      "method": "POST",
      "headers": {
        "content-type": "application/json"
      },
      "body": "{\"title\":\"some title\", \"body\":\"some body\"}"
    },
    "get_comments": {
      "url": "{url}/comments",
      "method": "GET",
      "query": {
        "postId": "100" 
      }
    }
  }
}
